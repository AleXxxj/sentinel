# Copy this file to `.env` and fill in real values.

# Secret used to sign JWT tokens. Generate a strong one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# Database URL.
# - Local development (default): SQLite file, zero setup.
#     sqlite:///./sentinel.db
# - Production: PostgreSQL, e.g.
#     postgresql+psycopg://user:password@localhost:5432/sentinel
DATABASE_URL=sqlite:///./sentinel.db

# How long a user (super/owner) login token stays valid, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# How long a device token stays valid, in days. Devices report for a long time,
# so this is long-lived; removal is handled by the secure remove flow, not expiry.
DEVICE_TOKEN_EXPIRE_DAYS=3650

# The first super admin, created by `python seed.py`.
FIRST_SUPERADMIN_EMAIL=admin@example.com
FIRST_SUPERADMIN_PASSWORD=change-me-now
